# CRM Pro Web Portal — environment template.
# Copy to `.env` and adjust per environment. Vite only exposes variables
# prefixed with VITE_ to client code.

# Base URL of the CRM Pro backend, including the /api prefix and no
# trailing slash. Every request the portal makes is resolved against it.
VITE_API_BASE_URL=http://97.74.89.70:3000/api
